# ==============================================================================
# BASIS PROTOCOL CONFIGURATION
# ==============================================================================
# Copy this file to `.env` or `backend/.env` to configure your local environment.
# By default, BASIS runs out-of-the-box in DEMO mode without requiring external
# RPC keys or a live PostgreSQL database.

# ------------------------------------------------------------------------------
# 1. RUNTIME MODE
# ------------------------------------------------------------------------------
# Options: "demo" (default) or "live"
APP_MODE=demo

# Session cookie encryption secret.
# In "demo" mode, an insecure default is derived automatically.
# In "live" mode, this is REQUIRED (e.g. generate with `openssl rand -hex 32`).
SESSION_SECRET=basis-demo-insecure-session-secret
SESSION_TTL_MS=43200000
AUTH_NONCE_TTL_MS=300000

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE (POSTGRESQL)
# ------------------------------------------------------------------------------
# In demo mode, fallback is used if omitted. Required for production deployment.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/basis

# ------------------------------------------------------------------------------
# 3. ATTESTCOIN (USC) CROSS-CHAIN ATTESTATION
# ------------------------------------------------------------------------------
# Set to "false" to disable external USC attestation calls in live mode.
ATTESTCOIN_ENABLED=true
ATTESTCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
ATTESTCOIN_PROVER_URL=https://prover.cc3-testnet.creditcoin.network
ATTESTCOIN_BLOCK_PROVER_ADDRESS=0x0000000000000000000000000000000000000FD2
ATTESTCOIN_CHAIN_INFO_ADDRESS=0x0000000000000000000000000000000000000fd3
ATTESTCOIN_ATTESTATION_TIMEOUT_MS=900000
ATTESTCOIN_ATTESTATION_POLL_MS=15000

# ------------------------------------------------------------------------------
# 4. CREDITCOIN (CC3) SETTLEMENT LAYER
# ------------------------------------------------------------------------------
# Set to "false" to disable CC3 settlement in live mode.
CREDITCOIN_ENABLED=true
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_CHAIN_ID=102031

# Deployed BASIS Credit Ledger contract on CC3.
# When empty in live mode, CreditcoinProvider operates in mirror mode (onchain: false).
CREDITCOIN_LEDGER_ADDRESS=

# Private key for the automated settlement relayer account on CC3.
# NEVER expose this key or commit it to version control!
CREDITCOIN_SETTLEMENT_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 5. EVM JSON-RPC PROVIDERS
# ------------------------------------------------------------------------------
# Configure real RPC endpoints to ingest live on-chain activity.
SEPOLIA_RPC_URL=https://rpc.sepolia.org
ETHEREUM_RPC_URL=https://eth.llamarpc.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# ------------------------------------------------------------------------------
# 6. CREDIT & EVIDENCE ENGINE PARAMETERS
# ------------------------------------------------------------------------------
# Maximum credit limit increase allowed per batch evaluation (USD).
CREDIT_MAX_BATCH_INCREASE_USD=5000

# Hard ceiling on total credit limit for any single wallet (USD).
CREDIT_ABSOLUTE_CAP_USD=50000

# Minimum evidence score threshold S = C^0.45 * D^0.30 * Q^0.25 (range 0.0 to 1.0).
# Scores below this generate a zero-increase decision.
CREDIT_MIN_EVIDENCE_THRESHOLD=0.1

# Minimum time (in milliseconds) between evaluations for a given wallet.
CREDIT_EVALUATION_COOLDOWN_MS=60000

# Historical event stale cutoff (in days).
CREDIT_STALE_EVENT_MAX_AGE_DAYS=730

# Minimum distinct verified events required before credit is unlocked.
CREDIT_MIN_EVENTS=3

# ------------------------------------------------------------------------------
# 7. DEMO & SIMULATION TUNING
# ------------------------------------------------------------------------------
# Artificial delay (in ms) per pipeline stage in demo mode for visual observability.
JOB_DEMO_STEP_DELAY_MS=450

# Rate limiting windows
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_MUTATION_MAX=60
RATE_LIMIT_READ_MAX=300
