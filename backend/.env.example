# ============================================================================
# BASIS — environment configuration
# Copy to .env and fill in. Never commit real secrets.
# ============================================================================

# --- Core -------------------------------------------------------------------
# demo  = deterministic seeded providers (no network access, fully functional)
# live  = real chain RPC, real Attestcoin/USC verification, real Creditcoin
APP_MODE=demo

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# REQUIRED when APP_MODE=live. Signs/validates server-side session material.
SESSION_SECRET=

# --- Credit engine ----------------------------------------------------------
CREDIT_MAX_BATCH_INCREASE_USD=5000
CREDIT_ABSOLUTE_CAP_USD=50000
CREDIT_MIN_EVIDENCE_THRESHOLD=0.1
CREDIT_EVALUATION_COOLDOWN_MS=60000
CREDIT_STALE_EVENT_MAX_AGE_DAYS=730
CREDIT_MIN_EVENTS=3
CREDIT_MAX_EVENTS_PER_EVALUATION=500

# --- Evidence engine --------------------------------------------------------
EVIDENCE_MIN_FUNDING_SHARE=0.05
EVIDENCE_MIN_FUNDING_USD=10
EVIDENCE_INSTANT_REPAY_WINDOW_MS=600000
EVIDENCE_SCRIPTED_GAP_MS=5000

# --- Source chain RPC (server-side only, never exposed to the browser) ------
SEPOLIA_RPC_URL=
ETHEREUM_RPC_URL=
BASE_SEPOLIA_RPC_URL=
BASE_RPC_URL=

# Optional Blockscout v2 base URLs. Without them, live history falls back to a
# strictly bounded RPC block scan and reports `partial` in the job metrics.
ETHEREUM_SEPOLIA_EXPLORER_API_URL=
BASE_SEPOLIA_EXPLORER_API_URL=

# Optional: ERC-20 metadata for live log decoding
# ASSET_SYMBOL_<CONTRACT_ADDRESS_WITHOUT_0X>=USDC
# ASSET_DECIMALS_<CONTRACT_ADDRESS_WITHOUT_0X>=6

# Live chain ingest bounds
CHAIN_SCAN_MAX_BLOCKS=2000

# --- Attestcoin (USC) -------------------------------------------------------
# Official SDK: @gluwa/usc-sdk. BlockProver precompile 0x..0FD2, ChainInfo 0x..0FD3.
ATTESTCOIN_ENABLED=true
ATTESTCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
ATTESTCOIN_PROVER_URL=https://prover.cc3-testnet.creditcoin.network
ATTESTCOIN_BLOCK_PROVER_ADDRESS=0x0000000000000000000000000000000000000FD2
ATTESTCOIN_CHAIN_INFO_ADDRESS=0x0000000000000000000000000000000000000fd3
ATTESTCOIN_ATTESTATION_TIMEOUT_MS=900000
ATTESTCOIN_ATTESTATION_POLL_MS=15000
ATTESTCOIN_REQUEST_TIMEOUT_MS=15000

# --- Creditcoin -------------------------------------------------------------
# CC3 testnet chainId 102031, mainnet 102030.
CREDITCOIN_ENABLED=true
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_CHAIN_ID=102031

# BASIS credit ledger contract deployed on Creditcoin (see docs/CREDITCOIN.md).
# Leave empty to keep credit state in Postgres only — settlements then report
# settled=false instead of pretending to have written on-chain.
CREDITCOIN_LEDGER_ADDRESS=
CREDITCOIN_SETTLEMENT_PRIVATE_KEY=

# --- Jobs -------------------------------------------------------------------
JOB_DEMO_STEP_DELAY_MS=450
JOB_STEP_TIMEOUT_MS=120000
JOB_TIMEOUT_MS=900000
JOB_REAPER_INTERVAL_MS=60000

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_MUTATION_MAX=60
RATE_LIMIT_READ_MAX=300
